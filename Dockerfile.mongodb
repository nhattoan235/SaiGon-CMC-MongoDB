FROM php:8.3-cli
RUN apt-get update && apt-get install -y --no-install-recommends git unzip libzip-dev libpng-dev libicu-dev libxml2-dev libssl-dev pkg-config \
    && docker-php-ext-install pdo_mysql zip gd intl bcmath \
    && pecl install mongodb-2.5.0 \
    && docker-php-ext-enable mongodb \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app/laravel
